{
  "name": "example",
  "private": true,
  "type": "module",
  "scripts": {
    "copy-dev-files": "cp tsconfig.dev.json tsconfig.json ",
    "copy-prod-files": "rm -rf tsconfig.json && cp tsconfig.prod.json tsconfig.json ",
    "copy-example-files": "rm -rf tsconfig.json && cp tsconfig.example.json tsconfig.json ",
    "build": "rm -rf build  &&  pnpm run copy-prod-files && pnpm run typecheck && react-router build",
    "dev": "NODE_ENV=development && pnpm run copy-dev-files &&  react-router dev",
    "dev:example": "NODE_ENV=development && pnpm run copy-example-files &&  react-router dev --config vite.config.example.ts",
    "build:example": "NODE_ENV=production && pnpm run copy-example-files &&  react-router build --config vite.config.example.ts",
    "start": "PORT=4173 react-router-serve ./build/server/index.js",
    "serve": "vite preview",
    "typecheck": "react-router typegen && tsc"
  },
  "dependencies": {
    "@devgateway/dvz-ui-react": "workspace:*",
    "@devgateway/wp-react-lib": "workspace:*",
    "@nivo/colors": "^0.96.0",
    "@react-router/node": "~7.9.4",
    "@react-router/serve": "~7.9.4",
    "dotenv": "^17.2.3",
    "dotenv-expand": "^12.0.3",
    "immutable": "^5.1.4",
    "isbot": "^5.1.27",
    "lodash": "^4.17.21",
    "papaparse": "^5.5.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.11",
    "react-redux": "~9.2.0",
    "react-router": "~7.9.4",
    "semantic-ui-css": "^2.5.0",
    "semantic-ui-react": "3.0.0-beta.2"
  },
  "devDependencies": {
    "@react-router/dev": "~7.9.4",
    "@types/node": "^20",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "react-router-devtools": "^5.0.6",
    "sass-embedded": "^1.93.2",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-commonjs": "^0.10.4",
    "vite-plugin-env-compatible": "^2.0.1",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
