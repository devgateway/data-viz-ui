{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "dvz-ui",
  "homepage": "https://github.com/devgateway/data-viz-ui",
  "items": [
    {
      "name": "container",
      "type": "registry:component",
      "ssr": "server",
      "description": "Max-width centred layout wrapper. Replaces SUI Container.",
      "dependencies": ["class-variance-authority", "clsx", "tailwind-merge"],
      "files": [{ "path": "components/container.tsx", "type": "registry:component" }]
    },
    {
      "name": "grid",
      "type": "registry:component",
      "ssr": "server",
      "description": "16-column responsive grid. Replaces SUI Grid, GridColumn, GridRow.",
