      "description": "Autocomplete search input. Replaces SUI Search.",
      "dependencies": ["@radix-ui/react-popover", "cmdk", "lucide-react", "clsx", "tailwind-merge"],
      "files": [
        { "path": "components/search-input.tsx", "type": "registry:component" },
        { "path": "components/spinner.tsx", "type": "registry:component" }
      ]
    },
    {
      "name": "use-controllable-state",
      "type": "registry:hook",
      "ssr": "server",
      "description": "Controlled/uncontrolled state hook. Replaces SUI useAutoControlledValue.",
      "files": [{ "path": "hooks/use-controllable-state.ts", "type": "registry:hook" }]
    },
    {
      "name": "use-composed-refs",
      "type": "registry:hook",
      "ssr": "server",
      "description": "Merges multiple React refs. Replaces SUI useMergedRefs.",
      "files": [{ "path": "hooks/use-composed-refs.ts", "type": "registry:hook" }]
    },
    {
      "name": "use-outside-click",
      "type": "registry:hook",
      "ssr": "server",
      "description": "Click-outside handler. Replaces SUI eventStack.",
      "files": [{ "path": "hooks/use-outside-click.ts", "type": "registry:hook" }]
    },
    {
      "name": "use-escape-key",
      "type": "registry:hook",
      "ssr": "server",
      "description": "Escape key handler. Replaces SUI eventStack.",
      "files": [{ "path": "hooks/use-escape-key.ts", "type": "registry:hook" }]
    },
    {
      "name": "use-isomorphic-layout-effect",
      "type": "registry:hook",
      "ssr": "server",
      "description": "SSR-safe layout effect. Mirrors SUI's pattern.",
      "files": [{ "path": "hooks/use-isomorphic-layout-effect.ts", "type": "registry:hook" }]
    }
