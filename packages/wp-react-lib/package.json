{
  "name": "@devgateway/wp-react-lib",
  "version": "0.6.1",
  "author": "Sebastian Dimunzio <sdimunzio@developmentgateway.org/>",
  "type": "module",
  "files": [
    "dist",
    "README.md"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "types": "dist/types/index.d.ts",
  "license": "MIT",
  "dependencies": {
    "@devgateway/ui": "workspace:*",
    "immutable": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-redux": "^9.2.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.15.19",
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "^4.4.1",
    "rollup-plugin-preserve-directives": "^0.4.0",
    "typescript": "^5.9.3",
    "vite": "^6.3.6",
    "vite-plugin-dts": "^4.5.4",
    "vite-tsconfig-paths": "^5.1.4"
  },
  "peerDependencies": {
    "@tanstack/react-query": "^5.0.0",
    "immutable": "^5.1.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^7.1.14",
    "react-redux": "^9.2.0"
  },
  "scripts": {
    "dist": "vite build && npm link",
    "dev": "vite build --watch",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "version": "changeset version"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/devgateway/dg-wp-react.git",
    "directory": "wp-react-lib"
  },
  "keywords": [
    "react",
    "dg-data-viz",
    "data-viz",
    "wp-react-lib",
    "wordpress"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./api": {
      "types": "./dist/types/api/index.d.ts",
      "import": "./dist/esm/api/index.js",
      "require": "./dist/cjs/api/index.js"
    },
    "./hooks": {
      "types": "./dist/types/hooks/index.d.ts",
      "import": "./dist/esm/hooks/index.js",
      "require": "./dist/cjs/hooks/index.js"
    },
    "./ssr": {
      "types": "./dist/types/ssr/index.d.ts",
      "import": "./dist/esm/ssr/index.js",
      "require": "./dist/cjs/ssr/index.js"
    },
    "./query": {
      "types": "./dist/types/query/index.d.ts",
      "import": "./dist/esm/query/index.js",
      "require": "./dist/cjs/query/index.js"
    },
    "./redux": {
      "types": "./dist/types/redux/index.d.ts",
      "import": "./dist/esm/redux/index.js",
      "require": "./dist/cjs/redux/index.js"
    }
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    }
  }
}
